PORT=3000
# Em produção (Neon): DATABASE_URL = conexão com pooler; DIRECT_URL = conexão direta (migrations)
DATABASE_URL=postgresql://gym:gym@localhost:5432/gymdb?schema=public
DIRECT_URL=postgresql://gym:gym@localhost:5432/gymdb?schema=public
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
# Fuso usado para "hoje" (vencimentos, turmas do dia, aniversários)
APP_TIMEZONE=America/Sao_Paulo
# Segredo do Cloud Scheduler para POST /api/internal/billing/daily (header X-Cron-Secret).
# Vazio = rotina diária desligada.
CRON_SECRET=

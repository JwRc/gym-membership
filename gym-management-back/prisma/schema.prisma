generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // conexão direta para migrations (com pooler, como no Neon, a DATABASE_URL passa pelo pooler)
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Multi-tenant: every academy (Tenant) has its own isolated data.
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STUDENT
}

enum Gender {
  M
  F
}

enum StudentStatus {
  ACTIVE // Ativo
  INACTIVE // Inativo
  LOCKED // Trancado (isento)
}

enum InvoiceStatus {
  PENDING // A vencer / vence hoje
  OVERDUE // Atrasado (marcado pelo job diário após a tolerância)
  PAID
  EXEMPT // Trancado / isento
}

enum TxType {
  INCOME
  EXPENSE
}

enum TxStatus {
  PENDING
  PAID
}

enum TxSource {
  MANUAL
  INVOICE
  SALE
}

enum PaymentMethod {
  PIX
  CASH
  DEBIT
  CREDIT
}

// ─── Famílias ───

/// Cobrança da família: cada membro com sua mensalidade, ou uma cobrança única no mês
enum BillingMode {
  SEPARATE
  CONSOLIDATED
}

/// Regra do desconto família
enum DiscountKind {
  NONE
  STATIC // cada membro recebe D
  PROGRESSIVE // o k-ésimo membro recebe (k−1)×D; o 1º paga cheio
  FAMILY_FIXED // D sobre o total da família (só cobrança consolidada)
}

enum DiscountValueType {
  FIXED // R$
  PERCENT // %
}

/// Desconto da família: o padrão da academia, uma regra própria, ou nenhum
enum DiscountOverride {
  INHERIT
  CUSTOM
  NONE
}

model Tenant {
  id                   String            @id @default(cuid())
  name                 String
  initials             String
  code                 String            @unique // Código de acesso dos alunos (ex.: TATAME-4821)
  cnpj                 String?
  phone                String?
  address              String?
  dueDays              Int[]             @default([1, 5, 10, 15, 20, 30])
  lateToleranceDays    Int               @default(3)
  autoGenerateInvoices Boolean           @default(true)
  /// Desconto família padrão da academia (cada família pode sobrescrever)
  familyDiscountKind   DiscountKind      @default(NONE)
  familyDiscountType   DiscountValueType @default(PERCENT)
  familyDiscountValue  Decimal           @default(0) @db.Decimal(10, 2)
  createdAt            DateTime          @default(now())

  users         User[]
  instructors   Instructor[]
  disciplines   Discipline[]
  plans         Plan[]
  students      Student[]
  classGroups   ClassGroup[]
  invoices      Invoice[]
  transactions  Transaction[]
  products      Product[]
  sales         Sale[]
  auditLogs     AuditLog[]
  guardians     Guardian[]
  families      Family[]
  familyCharges FamilyCharge[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  studentId    String?   @unique
  student      Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  /// titular de família (preparação para o portal; ainda sem login criado pelo sistema)
  guardianId   String?   @unique
  guardian     Guardian? @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  /// incrementado ao trocar a senha: tokens com versão antiga deixam de valer
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
}

/// Quem fez o quê: toda escrita de usuário logado e ações sensíveis (login, import, export, anonimização).
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}

model Instructor {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  disciplines Discipline[]
  classGroups ClassGroup[]

  @@index([tenantId])
}

// ─── Catálogo padrão (global, igual para todas as academias) ───

model CatalogDiscipline {
  id                  String         @id // slug: bjj, mt, box…
  name                String
  color               String
  system              String // "Faixas e graus", "Prajied"…
  degreesPerLevel     Int            @default(0) // BJJ: 4 graus por faixa
  lastLevelMaxDegrees Int            @default(0) // BJJ: faixa preta até 6º grau
  degreeMinMonths     Int?
  degreeMinClasses    Int?
  levels              CatalogLevel[]
  disciplines         Discipline[]
}

model CatalogLevel {
  id           String            @id @default(cuid())
  disciplineId String
  discipline   CatalogDiscipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  order        Int
  name         String
  color        String
  color2       String? // 2ª cor (faixas bicolores, ex.: kruang); null = uma cor
  minMonths    Int?
  minClasses   Int?

  @@unique([disciplineId, order])
}

// ─── Modalidade da academia (cópia do catálogo, editável) ───

model Discipline {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originId            String?
  origin              CatalogDiscipline? @relation(fields: [originId], references: [id])
  customizedAt        DateTime? // null = idêntica ao catálogo
  name                String
  color               String
  system              String
  degreesPerLevel     Int                @default(0)
  lastLevelMaxDegrees Int                @default(0)
  degreeMinMonths     Int?
  degreeMinClasses    Int?
  monthlyPrice        Decimal            @db.Decimal(10, 2)
  instructorId        String?
  instructor          Instructor?        @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  archived            Boolean            @default(false)
  levels              DisciplineLevel[]
  ranks               StudentRank[]
  promotions          Promotion[]
  classGroups         ClassGroup[]
  plans               PlanDiscipline[]

  @@index([tenantId])
}

model DisciplineLevel {
  id           String     @id @default(cuid())
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  order        Int
  name         String
  color        String
  color2       String? // 2ª cor (faixas bicolores, ex.: kruang); null = uma cor
  minMonths    Int?
  minClasses   Int?

  @@unique([disciplineId, order])
}

model Plan {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal          @db.Decimal(10, 2)
  archived    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  students    Student[]
  disciplines PlanDiscipline[]
  classGroups PlanClassGroup[]

  @@index([tenantId])
}

// Modalidades do plano: quem entra no plano é matriculado nelas
model PlanDiscipline {
  planId       String
  plan         Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([planId, disciplineId])
}

// Turmas do plano (opcional): quem entra no plano vai para elas
model PlanClassGroup {
  planId       String
  plan         Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@id([planId, classGroupId])
}

model Student {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  gender           Gender?
  birthDate        DateTime      @db.Date
  /// opcional só para membros de família (o contato fica com o titular)
  email            String?
  phone            String?
  status           StudentStatus @default(ACTIVE)
  monthlyFee       Decimal       @db.Decimal(10, 2)
  dueDay           Int
  startDate        DateTime      @db.Date
  medicalNotes     String?
  guardianName     String?
  guardianRelation String?
  guardianPhone    String?
  planId           String?
  plan             Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  familyId         String?
  family           Family?       @relation(fields: [familyId], references: [id], onDelete: SetNull)
  /// LGPD: quando o aluno (ou responsável) autorizou o uso dos dados, inclusive de saúde
  consentAt        DateTime?
  /// LGPD: dados pessoais apagados a pedido; mensalidades e vendas ficam (registros financeiros)
  anonymizedAt     DateTime?
  createdAt        DateTime      @default(now())

  user        User?
  ranks       StudentRank[]
  promotions  Promotion[]
  enrollments Enrollment[]
  attendances Attendance[]
  invoices    Invoice[]
  sales       Sale[]
  guardianOf  Guardian?

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([familyId])
}

/// Titular (responsável financeiro) de uma família. Pode ou não treinar.
model Guardian {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  cpf       String?
  relation  String? // Mãe, Pai…
  /// o titular também treina
  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  family    Family?
  user      User?
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@unique([tenantId, cpf])
}

model Family {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  guardianId       String             @unique
  guardian         Guardian           @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  billingMode      BillingMode        @default(SEPARATE)
  /// vencimento único da cobrança consolidada
  dueDay           Int?
  discountOverride DiscountOverride   @default(INHERIT)
  discountKind     DiscountKind?
  discountType     DiscountValueType?
  discountValue    Decimal?           @db.Decimal(10, 2)
  createdAt        DateTime           @default(now())
  members          Student[]
  charges          FamilyCharge[]

  @@index([tenantId])
}

/// Cobrança consolidada do mês: agrupa as mensalidades dos membros (o total é a soma delas)
model FamilyCharge {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  familyId      String
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  year          Int
  month         Int
  dueDate       DateTime       @db.Date
  status        InvoiceStatus  @default(PENDING)
  paidAt        DateTime?      @db.Date
  paymentMethod PaymentMethod?
  createdAt     DateTime       @default(now())
  invoices      Invoice[]

  @@unique([familyId, year, month])
  @@index([tenantId, dueDate])
}

// Graduação atual do aluno em uma modalidade
model StudentRank {
  id              String     @id @default(cuid())
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  disciplineId    String
  discipline      Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  levelOrder      Int
  degree          Int        @default(0)
  levelSince      DateTime   @db.Date // data da faixa/nível atual
  lastPromotionAt DateTime   @db.Date // última graduação (faixa ou grau)
  classesSince    Int        @default(0) // aulas desde a última graduação

  @@unique([studentId, disciplineId])
}

model Promotion {
  id             String     @id @default(cuid())
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  disciplineId   String
  discipline     Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  levelOrder     Int
  degree         Int        @default(0)
  title          String
  date           DateTime   @db.Date
  instructorName String?

  @@index([studentId, disciplineId])
}

model ClassGroup {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline       @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  instructorId String?
  instructor   Instructor?      @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  name         String
  capacity     Int
  slots        ClassSlot[]
  enrollments  Enrollment[]
  attendances  Attendance[]
  plans        PlanClassGroup[]

  @@index([tenantId])
}

model ClassSlot {
  id           String     @id @default(cuid())
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  weekday      Int // 0 = segunda … 5 = sábado
  startMin     Int // minutos desde 00:00
  endMin       Int
}

model Enrollment {
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([studentId, classGroupId])
}

model Attendance {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date

  @@unique([studentId, classGroupId, date])
}

// Mensalidade
model Invoice {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  year           Int
  month          Int // 1–12
  dueDate        DateTime       @db.Date
  /// valor líquido (o bruto é amount + discount)
  amount         Decimal        @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  discountNote   String?
  status         InvoiceStatus  @default(PENDING)
  paidAt         DateTime?      @db.Date
  paymentMethod  PaymentMethod?
  manual         Boolean        @default(false)
  familyChargeId String?
  familyCharge   FamilyCharge?  @relation(fields: [familyChargeId], references: [id], onDelete: SetNull)
  transaction    Transaction?

  @@unique([studentId, year, month])
  @@index([tenantId, dueDate])
  @@index([familyChargeId])
}

// Lançamento financeiro
model Transaction {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  description String
  note        String?
  category    String
  type        TxType
  amount      Decimal  @db.Decimal(10, 2)
  status      TxStatus @default(PENDING)
  source      TxSource @default(MANUAL)
  invoiceId   String?  @unique
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
}

model Product {
  id       String     @id @default(cuid())
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  category String
  price    Decimal    @db.Decimal(10, 2)
  cost     Decimal    @db.Decimal(10, 2)
  stock    Int        @default(0)
  minStock Int        @default(0)
  archived Boolean    @default(false)
  items    SaleItem[]

  @@index([tenantId])
}

model Sale {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        Int
  date          DateTime      @db.Date
  studentId     String?
  student       Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod
  items         SaleItem[]
  transactions  Transaction[]

  @@unique([tenantId, number])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction)
  qty       Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)
}
